{
  "venvPath": "backend",
  "venv": ".venv",
  "extraPaths": [
    "backend",
    "backend/.venv/Lib/site-packages"
  ],
  "include": [
    "backend"
  ],
  "exclude": [
    "**/__pycache__",
    "backend/.venv",
    "frontend/node_modules"
  ],
  "reportIncompatibleVariableOverride": "none",
  "reportIncompatibleMethodOverride": "none"
}
